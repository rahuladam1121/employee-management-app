<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Employee Management</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #182230; background: #f5f7fb; }
      * { box-sizing: border-box; } body { margin: 0; }
      header { background: #172554; color: white; padding: 18px max(24px, calc((100% - 1120px)/2)); }
      header a { color: white; text-decoration: none; font-weight: 700; font-size: 20px; }
      main { max-width: 1120px; margin: 32px auto; padding: 0 20px 40px; }
      h1 { margin-top: 0; } .topbar { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; }
      .button, input[type=submit] { display:inline-block; border:0; border-radius:8px; padding:10px 14px; background:#1d4ed8; color:white; text-decoration:none; cursor:pointer; font:inherit; }
      .button.secondary { background:#e2e8f0; color:#172033; } .button.danger { background:#b91c1c; }
      .panel { background:white; border:1px solid #e2e8f0; border-radius:12px; padding:22px; box-shadow:0 2px 8px #0f172a0a; }
      table { width:100%; border-collapse:collapse; background:white; } th,td { padding:13px 12px; border-bottom:1px solid #e5e7eb; text-align:left; vertical-align:top; } th { background:#f8fafc; font-size:13px; text-transform:uppercase; color:#475569; }
      .table-wrap { overflow-x:auto; border:1px solid #e2e8f0; border-radius:12px; } .actions { display:flex; gap:10px; flex-wrap:wrap; }
      .field { margin-bottom:16px; } label { display:block; font-weight:600; margin-bottom:6px; } input,select { width:100%; max-width:640px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:7px; font:inherit; background:white; }
      .errors { color:#991b1b; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; padding:12px 18px; margin-bottom:18px; }
      .notice { background:#dcfce7; color:#166534; border-radius:8px; padding:12px 16px; margin-bottom:18px; }
      .muted { color:#64748b; } .details { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; } .detail-label { color:#64748b; font-size:13px; margin-bottom:4px; }
      @media(max-width:650px){ main{margin-top:20px} th,td{padding:10px;font-size:14px} }
    </style>
  </head>
  <body>
    <header><%= link_to "Employee Management", root_path %></header>
    <main>
      <% if notice.present? %><div class="notice"><%= notice %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>

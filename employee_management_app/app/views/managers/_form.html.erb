<%= form_with model: manager do |form| %>
  <% if manager.errors.any? %>
    <div class="errors"><strong><%= pluralize(manager.errors.count, "error") %> prevented this manager from being saved:</strong><ul>
      <% manager.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul></div>
  <% end %>

  <div class="details">
    <div class="field"><%= form.label :first_name, "First name *" %><%= form.text_field :first_name, required: true %></div>
    <div class="field"><%= form.label :last_name, "Last name *" %><%= form.text_field :last_name, required: true %></div>
    <div class="field"><%= form.label :email, "Work email *" %><%= form.email_field :email, required: true, placeholder: "name@example.com" %></div>
    <div class="field"><%= form.label :phone, "Phone" %><%= form.telephone_field :phone %></div>
  </div>
  <div class="actions"><%= form.submit %><%= link_to "Cancel", managers_path, class: "button secondary" %></div>
<% end %>
